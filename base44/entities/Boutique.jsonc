{
  "name": "Boutique",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom de la boutique"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo ou photo de la boutique"
    },
    "description": {
      "type": "string",
      "description": "Description de la boutique"
    },
    "categorie": {
      "type": "string",
      "description": "Catégorie (ex: alimentation, mode, electronique)"
    },
    "pays_code": {
      "type": "string",
      "enum": [
        "BF",
        "CI",
        "TG",
        "BJ",
        "SN",
        "ML",
        "GN",
        "NE",
        "GH"
      ],
      "description": "Code pays — isolation stricte"
    },
    "ville": {
      "type": "string"
    },
    "quartier": {
      "type": "string"
    },
    "adresse": {
      "type": "string",
      "description": "Adresse précise de l'établissement (géolocalisée)"
    },
    "latitude": {
      "type": "number",
      "description": "Position GPS FIXE de l'établissement (enregistrée manuellement)"
    },
    "longitude": {
      "type": "number",
      "description": "Position GPS FIXE de l'établissement (enregistrée manuellement)"
    },
    "telephone": {
      "type": "string",
      "description": "Téléphone de la boutique"
    },
    "telephone_depot": {
      "type": "string",
      "description": "Numéro Orange Money pour dépôt paiement"
    },
    "horaires": {
      "type": "string",
      "description": "JSON: [{jour, ouverture, fermeture}]"
    },
    "ouvert": {
      "type": "boolean",
      "default": true,
      "description": "Statut ouvert/fermé (manuel ou calculé)"
    },
    "actif": {
      "type": "boolean",
      "default": false,
      "description": "Boutique active sur la plateforme (true seulement après validation admin)"
    },
    "validation": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse",
        "suspendu"
      ],
      "default": "en_attente",
      "description": "Statut de validation par l'admin"
    },
    "motif_refus": {
      "type": "string",
      "description": "Motif de refus ou suspension"
    },
    "valide_par": {
      "type": "string",
      "description": "Email admin ayant validé/refusé"
    },
    "valide_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de validation"
    },
    "statut_validation": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse"
      ],
      "default": "en_attente",
      "description": "Statut de validation administrateur"
    },
    "commission_pct": {
      "type": "number",
      "description": "Commission configurable (fallback global si null)"
    },
    "nb_visites": {
      "type": "number",
      "default": 0,
      "description": "Nombre de visites de la fiche boutique cote client"
    },
    "derniere_visite_at": {
      "type": "string",
      "format": "date-time",
      "description": "Derniere visite de la fiche boutique"
    },
    "montant_du_silga": {
      "type": "number",
      "default": 0,
      "description": "Montant dû à SILGAPP (commissions)"
    },
    "partenaire_id": {
      "type": "string",
      "description": "User ID du partenaire propriétaire"
    },
    "user_email": {
      "type": "string",
      "description": "Email du partenaire propriétaire"
    },
    "creation_directe": {
      "type": "boolean",
      "default": false,
      "description": "Boutique créée sans validation préalable"
    },
    "creation_admin_notifiee": {
      "type": "boolean",
      "default": false,
      "description": "Accusé de lecture administrateur de la nouvelle boutique"
    }
  },
  "required": [
    "nom",
    "pays_code",
    "partenaire_id"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}