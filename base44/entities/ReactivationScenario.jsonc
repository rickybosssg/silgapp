{
  "name": "ReactivationScenario",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "description": "ID de la ReactivationCampaign automatique parente"
    },
    "client_id": {
      "type": "string",
      "description": "ID du ClientExterne cibl\u00e9"
    },
    "client_telephone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone du client (pour recherche)"
    },
    "client_phone_normalized": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone normalis\u00e9 (format international sans + ni espace). Utilis\u00e9 pour l'attribution."
    },
    "client_user_email": {
      "type": "string",
      "description": "Email du compte User li\u00e9 au client. R\u00e9solu c\u00f4t\u00e9 backend. Utilis\u00e9 pour l'attribution hybride (fallback t\u00e9l\u00e9phone)."
    },
    "country_code": {
      "type": "string",
      "description": "Code pays du client"
    },
    "segment": {
      "type": "string",
      "enum": [
        "vip",
        "regular",
        "occasional",
        "no_course",
        "creee_non_livree",
        "first_course_delivered"
      ],
      "description": "Segment: no_course (jamais command\u00e9), creee_non_livree (course cr\u00e9\u00e9e mais jamais livr\u00e9e), occasional (1 course livr\u00e9e inactif), regular (2-4 courses livr\u00e9es), vip (5+ courses livr\u00e9es), first_course_delivered (exactement 1 course livr\u00e9e, rappels J+1/J+3/J+7 depuis la livraison)"
    },
    "reference_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de r\u00e9f\u00e9rence pour le calcul des rappels. Pour first_course_delivered: date de livraison de la premi\u00e8re course. J+1/J+3/J+7 calcul\u00e9s depuis cette date. Null pour les autres segments (utilisent j0_sent_at)."
    },
    "ab_variant": {
      "type": "string",
      "description": "Variante A/B persistante pour tout le sc\u00e9nario (A ou B)"
    },
    "is_control_group": {
      "type": "boolean",
      "default": false,
      "description": "True si le client est dans le groupe contr\u00f4le (aucun push envoy\u00e9)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "converted",
        "completed",
        "expired"
      ],
      "default": "active",
      "description": "Statut du sc\u00e9nario: active=en cours, converted=course cr\u00e9\u00e9e, completed=tous les pushes envoy\u00e9s sans conversion, expired=J+5/J+7 d\u00e9pass\u00e9 sans conversion"
    },
    "j0_recipient_id": {
      "type": "string",
      "description": "ID du ReactivationCampaignRecipient pour le push J0 (ou J+1 pour first_course_delivered)"
    },
    "j0_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'envoi du push J0 (ou J+1 pour first_course_delivered)"
    },
    "j2_recipient_id": {
      "type": "string",
      "description": "ID du ReactivationCampaignRecipient pour le push J+2 (ou J+3 pour first_course_delivered)"
    },
    "j2_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'envoi du push J+2 (ou J+3 pour first_course_delivered)"
    },
    "j5_recipient_id": {
      "type": "string",
      "description": "ID du ReactivationCampaignRecipient pour le push J+5 (ou J+7 pour first_course_delivered)"
    },
    "j5_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'envoi du push J+5 (ou J+7 pour first_course_delivered)"
    },
    "next_push_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date pr\u00e9vue du prochain push (J0, J+2, J+5 ou J+1, J+3, J+7 pour first_course_delivered)"
    },
    "next_push_step": {
      "type": "number",
      "description": "Prochaine \u00e9tape: 0=J0, 2=J+2, 5=J+5. Pour first_course_delivered: 1=J+1, 3=J+3, 7=J+7. -1=termin\u00e9"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de conversion (course cr\u00e9\u00e9e)"
    },
    "course_id": {
      "type": "string",
      "description": "ID de la CourseExterne attribu\u00e9e"
    },
    "course_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de livraison de la course attribu\u00e9e"
    },
    "revenue": {
      "type": "number",
      "default": 0,
      "description": "CA g\u00e9n\u00e9r\u00e9 par la course attribu\u00e9e"
    },
    "commission": {
      "type": "number",
      "default": 0,
      "description": "Commission SILGAPP g\u00e9n\u00e9r\u00e9e"
    },
    "cooldown_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'expiration du cooldown avant qu'un nouveau sc\u00e9nario puisse d\u00e9marrer pour ce client"
    },
    "test_mode": {
      "type": "boolean",
      "default": false,
      "description": "True si le sc\u00e9nario a \u00e9t\u00e9 cr\u00e9\u00e9 en mode test"
    }
  },
  "required": [
    "campaign_id",
    "client_id",
    "segment",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}