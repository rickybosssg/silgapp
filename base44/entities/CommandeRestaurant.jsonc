{
  "name": "CommandeRestaurant",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "ID du restaurant"
    },
    "restaurant_nom": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "ClientExterne ID du client"
    },
    "client_nom": {
      "type": "string"
    },
    "client_telephone": {
      "type": "string"
    },
    "pays_code": {
      "type": "string",
      "enum": [
        "BF",
        "CI",
        "TG",
        "BJ",
        "SN",
        "ML",
        "GN",
        "NE",
        "GH",
        "MA"
      ],
      "description": "Code pays — isolation stricte"
    },
    "items": {
      "type": "string",
      "description": "JSON: [{id, nom, prix, quantite, photo_url}]"
    },
    "total": {
      "type": "number",
      "description": "Total plats uniquement (pas de frais livraison)"
    },
    "adresse_livraison": {
      "type": "string"
    },
    "quartier_livraison": {
      "type": "string"
    },
    "gps_lat": {
      "type": "number"
    },
    "gps_lng": {
      "type": "number"
    },
    "note_client": {
      "type": "string"
    },
    "preuve_paiement_url": {
      "type": "string",
      "description": "Photo preuve de paiement Orange Money"
    },
    "statut": {
      "type": "string",
      "enum": [
        "commande_envoyee",
        "commande_recue",
        "paiement_verification",
        "paiement_valide",
        "paiement_refuse",
        "en_preparation",
        "prete_recuperation",
        "livreur_assigne",
        "commande_recuperee",
        "en_livraison",
        "livree",
        "annulee"
      ],
      "default": "commande_envoyee"
    },
    "course_id": {
      "type": "string",
      "description": "ID de la CourseExterne créée quand prête (ou en avance si dispatch anticipé)"
    },
    "partenaire_id": {
      "type": "string",
      "description": "User ID du partenaire (filtrage rapide)"
    },
    "commission_pct": {
      "type": "number"
    },
    "commission_montant": {
      "type": "number"
    },
    "motif_annulation": {
      "type": "string"
    },
    "preparation_time_minutes": {
      "type": "number",
      "description": "Temps de préparation estimé par le restaurant (5, 10, 15, 20 ou 30 min). Saisi au passage en en_preparation. Si défini, la CourseExterne est créée en avance avec dispatch_status=en_attente et le dispatch est déclenché automatiquement au bon moment (dispatch_at)."
    },
    "estimated_ready_at": {
      "type": "string",
      "format": "date-time",
      "description": "Heure estimée à laquelle la commande sera prête = heure_debut_preparation + preparation_time_minutes."
    },
    "dispatch_at": {
      "type": "string",
      "format": "date-time",
      "description": "Heure à laquelle le dispatch doit être déclenché = estimated_ready_at - ETA_livreur - marge. L'automation dispatchAnticipeRestaurant bascule la course de en_attente vers disponible_push quand now >= dispatch_at."
    },
    "commerce_payment_proof_id": {
      "type": "string",
      "description": "Protected private payment proof reference set by the commerce server."
    }
  },
  "required": [
    "restaurant_id",
    "client_id",
    "pays_code",
    "total",
    "statut"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}