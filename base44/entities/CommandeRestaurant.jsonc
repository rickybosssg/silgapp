{
  "name": "CommandeRestaurant",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "ID du restaurant"
    },
    "restaurant_nom": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "ClientExterne ID du client"
    },
    "client_nom": {
      "type": "string"
    },
    "client_telephone": {
      "type": "string"
    },
    "pays_code": {
      "type": "string",
      "enum": [
        "BF",
        "CI",
        "TG",
        "BJ",
        "SN",
        "ML",
        "GN",
        "NE",
        "GH",
        "MA"
      ],
      "description": "Code pays \u2014 isolation stricte"
    },
    "items": {
      "type": "string",
      "description": "JSON: [{id, nom, prix, quantite, photo_url}]"
    },
    "total": {
      "type": "number",
      "description": "Total plats uniquement (pas de frais livraison)"
    },
    "adresse_livraison": {
      "type": "string"
    },
    "quartier_livraison": {
      "type": "string"
    },
    "gps_lat": {
      "type": "number"
    },
    "gps_lng": {
      "type": "number"
    },
    "note_client": {
      "type": "string"
    },
    "preuve_paiement_url": {
      "type": "string",
      "description": "Photo preuve de paiement Orange Money"
    },
    "statut": {
      "type": "string",
      "enum": [
        "commande_envoyee",
        "commande_recue",
        "paiement_verification",
        "paiement_valide",
        "paiement_refuse",
        "en_preparation",
        "prete_recuperation",
        "livreur_assigne",
        "commande_recuperee",
        "en_livraison",
        "livree",
        "annulee"
      ],
      "default": "commande_envoyee"
    },
    "course_id": {
      "type": "string",
      "description": "ID de la CourseExterne cr\u00e9\u00e9e quand pr\u00eate (ou en avance si dispatch anticip\u00e9)"
    },
    "partenaire_id": {
      "type": "string",
      "description": "User ID du partenaire (filtrage rapide)"
    },
    "commission_pct": {
      "type": "number"
    },
    "commission_montant": {
      "type": "number"
    },
    "motif_annulation": {
      "type": "string"
    },
    "preparation_time_minutes": {
      "type": "number",
      "description": "Temps de pr\u00e9paration estim\u00e9 par le restaurant (5, 10, 15, 20 ou 30 min). Saisi au passage en en_preparation. Si d\u00e9fini, la CourseExterne est cr\u00e9\u00e9e en avance avec dispatch_status=en_attente et le dispatch est d\u00e9clench\u00e9 automatiquement au bon moment (dispatch_at)."
    },
    "estimated_ready_at": {
      "type": "string",
      "format": "date-time",
      "description": "Heure estim\u00e9e \u00e0 laquelle la commande sera pr\u00eate = heure_debut_preparation + preparation_time_minutes."
    },
    "dispatch_at": {
      "type": "string",
      "format": "date-time",
      "description": "Heure \u00e0 laquelle le dispatch doit \u00eatre d\u00e9clench\u00e9 = estimated_ready_at - ETA_livreur - marge. L'automation dispatchAnticipeRestaurant bascule la course de en_attente vers disponible_push quand now >= dispatch_at."
    }
  },
  "required": [
    "restaurant_id",
    "client_id",
    "pays_code",
    "total",
    "statut"
  ]
}