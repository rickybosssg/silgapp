{
  "name": "PushTelemetryEvent",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string",
      "description": "ID de la CourseExterne concern\u00e9e"
    },
    "livreur_id": {
      "type": "string",
      "description": "ID du livreur destinataire de la notification"
    },
    "livreur_user_email": {
      "type": "string",
      "description": "Email du compte User du livreur. R\u00e9solu c\u00f4t\u00e9 backend UNIQUEMENT. Permet la RLS read pour que le livreur voie ses propres \u00e9v\u00e9nements."
    },
    "notification_id": {
      "type": "string",
      "description": "ID de la Notification (cr\u00e9\u00e9e par envoiNotificationPush) ou DispatchNotification concern\u00e9e"
    },
    "dispatch_notification_id": {
      "type": "string",
      "description": "ID du DispatchNotification concern\u00e9 si applicable"
    },
    "device_id": {
      "type": "string",
      "description": "Identifiant d'appareil SILGAPP (dev_UUID) si disponible"
    },
    "fcm_token_prefix": {
      "type": "string",
      "description": "Pr\u00e9fixe du token FCM (16 premiers caract\u00e8res) pour corr\u00e9lation sans stocker le token complet"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "push_requested",
        "push_succes",
        "push_echec",
        "notification_received",
        "notification_opened",
        "app_opened_from_notification",
        "course_screen_opened",
        "acceptation_attempt",
        "accepte",
        "refuse",
        "already_taken",
        "race_condition_perdue"
      ],
      "description": "Type d'\u00e9v\u00e9nement de t\u00e9l\u00e9m\u00e9trie push"
    },
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "ios",
        "web"
      ],
      "description": "Plateforme du dispositif"
    },
    "country_code": {
      "type": "string",
      "description": "Code pays du livreur (snapshot pour filtrage analytique)"
    },
    "source": {
      "type": "string",
      "enum": [
        "backend",
        "native_android",
        "native_ios",
        "frontend"
      ],
      "description": "Origine de l'\u00e9v\u00e9nement"
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp exact de l'\u00e9v\u00e9nement c\u00f4t\u00e9 source (peut diff\u00e9rer de created_date si l'\u00e9v\u00e9nement a \u00e9t\u00e9 diff\u00e9r\u00e9)"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Cl\u00e9 d'idempotence = course_id + livreur_id + event_type + timestamp_arrondi_minute. Emp\u00eache les doublons pour le m\u00eame \u00e9v\u00e9nement."
    },
    "metadata": {
      "type": "string",
      "description": "JSON: m\u00e9tadonn\u00e9es techniques suppl\u00e9mentaires (ex: {reason, error, fcm_message_id, app_state})"
    }
  },
  "required": [
    "course_id",
    "livreur_id",
    "event_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.livreur_user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.livreur_user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}