{
  "name": "ReactivationCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de la campagne"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sending",
        "sent",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Statut de la campagne"
    },
    "segment_type": {
      "type": "string",
      "enum": [
        "push_active",
        "push_recoverable",
        "all_push_eligible",
        "external_no_account"
      ],
      "default": "push_active",
      "description": "Type de segment cibl\u00e9"
    },
    "country_code": {
      "type": "string",
      "description": "Code pays ISO 2 lettres (vide = tous les pays)"
    },
    "city": {
      "type": "string",
      "description": "Ville (vide = toutes les villes)"
    },
    "course_min": {
      "type": "number",
      "default": 0,
      "description": "Nombre minimum de courses du client"
    },
    "course_max": {
      "type": "number",
      "description": "Nombre maximum de courses du client (vide = pas de limite)"
    },
    "max_targets": {
      "type": "number",
      "default": 0,
      "description": "Nombre maximum de clients \u00e0 cibler (0 = pas de limite). Utilis\u00e9 pour les campagnes pilotes afin de limiter la taille du segment."
    },
    "inactive_days_min": {
      "type": "number",
      "description": "Inactivit\u00e9 minimum en jours depuis la derni\u00e8re course"
    },
    "title": {
      "type": "string",
      "description": "Titre de la notification push"
    },
    "message": {
      "type": "string",
      "description": "Message de la notification push"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure d'envoi programm\u00e9"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "description": "Email de l'admin cr\u00e9ateur"
    },
    "target_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre total de clients cibl\u00e9s (incluant groupe contr\u00f4le)"
    },
    "delivered_count": {
      "type": "number",
      "default": 0
    },
    "opened_count": {
      "type": "number",
      "default": 0
    },
    "course_created_count": {
      "type": "number",
      "default": 0
    },
    "course_completed_count": {
      "type": "number",
      "default": 0
    },
    "revenue_generated": {
      "type": "number",
      "default": 0,
      "description": "Chiffre d'affaires total g\u00e9n\u00e9r\u00e9 par les conversions"
    },
    "commission_generated": {
      "type": "number",
      "default": 0,
      "description": "Commission SILGAPP g\u00e9n\u00e9r\u00e9e par les conversions"
    },
    "promo_cost": {
      "type": "number",
      "default": 0,
      "description": "Co\u00fbt promotionnel (remises, bonus). Toujours 0 par d\u00e9faut \u2014 aucune r\u00e9duction automatique."
    },
    "net_result": {
      "type": "number",
      "default": 0,
      "description": "R\u00e9sultat net = commission g\u00e9n\u00e9r\u00e9e - co\u00f9t promotionnel"
    },
    "is_ab_test": {
      "type": "boolean",
      "default": false,
      "description": "True si la campagne est un test A/B"
    },
    "ab_variants": {
      "type": "string",
      "description": "JSON: [{variant, title, message}] pour les tests A/B"
    },
    "control_group_pct": {
      "type": "number",
      "default": 0,
      "description": "Pourcentage du segment conserv\u00e9 comme groupe contr\u00f4le (0-100). Ne re\u00e7oit aucune notification."
    },
    "attribution_window_hours": {
      "type": "number",
      "default": 72,
      "description": "Fen\u00eatre d'attribution en heures apr\u00e8s envoi du push"
    },
    "sent_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de notifications envoy\u00e9es (hors groupe contr\u00f4le)"
    },
    "control_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de clients dans le groupe contr\u00f4le"
    },
    "failed_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre d'\u00e9checs d'envoi FCM"
    },
    "is_automatic": {
      "type": "boolean",
      "default": false,
      "description": "True si la campagne est g\u00e9r\u00e9e par le moteur automatique J0/J+2/J+5. Les campagnes manuelles restent is_automatic=false."
    },
    "scenario_paused": {
      "type": "boolean",
      "default": false,
      "description": "True si le moteur automatique est en pause (admin). Les sc\u00e9narios en cours continuent mais aucun nouveau sc\u00e9nario ne d\u00e9marre."
    },
    "test_mode": {
      "type": "boolean",
      "default": false,
      "description": "True si le moteur est en mode test (uniquement les t\u00e9l\u00e9phones de test, d\u00e9lais raccourcis)"
    },
    "test_phones": {
      "type": "string",
      "description": "JSON: tableau des t\u00e9l\u00e9phones de test (mode test uniquement)"
    },
    "smart_segment": {
      "type": "string",
      "enum": [
        "vip",
        "regular",
        "occasional",
        "no_course",
        "all"
      ],
      "default": "all",
      "description": "Segment intelligent pour le moteur auto: vip (5+ courses inactif), regular (2-4 courses inactif), occasional (1 course inactif), no_course (0 course inscrit), all (tous \u00e9ligibles)"
    },
    "j0_message_a": {
      "type": "string",
      "description": "Message J0 variante A (moteur auto)"
    },
    "j0_message_b": {
      "type": "string",
      "description": "Message J0 variante B (moteur auto)"
    },
    "j2_message_a": {
      "type": "string",
      "description": "Message J+2 variante A (moteur auto)"
    },
    "j2_message_b": {
      "type": "string",
      "description": "Message J+2 variante B (moteur auto)"
    },
    "j5_message_a": {
      "type": "string",
      "description": "Message J+5 variante A (moteur auto)"
    },
    "j5_message_b": {
      "type": "string",
      "description": "Message J+5 variante B (moteur auto)"
    },
    "push_interval_days": {
      "type": "number",
      "default": 2,
      "description": "D\u00e9lai en jours entre J0 et J+2"
    },
    "push_interval_2_days": {
      "type": "number",
      "default": 3,
      "description": "D\u00e9lai en jours entre J+2 et J+5"
    },
    "cooldown_days": {
      "type": "number",
      "default": 30,
      "description": "D\u00e9lai en jours avant qu'un m\u00eame client puisse entrer dans un nouveau sc\u00e9nario"
    }
  },
  "required": [
    "name",
    "status",
    "segment_type",
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}