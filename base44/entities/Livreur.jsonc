{
  "name": "Livreur",
  "type": "object",
  "properties": {
    "reseau": {
      "type": "string",
      "enum": [
        "interne",
        "externe"
      ],
      "default": "interne"
    },
    "type_livreur": {
      "type": "string",
      "enum": [
        "interne",
        "externe"
      ],
      "default": "interne"
    },
    "country_code": {
      "type": "string",
      "description": "Code pays ISO 2 lettres (ex: BF, CI, TG). Dynamique : aucun pays cod\u00e9 en dur."
    },
    "prenom": {
      "type": "string"
    },
    "nom": {
      "type": "string"
    },
    "telephone": {
      "type": "string"
    },
    "mot_de_passe": {
      "type": "string"
    },
    "quartier": {
      "type": "string"
    },
    "ville": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "validation": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse"
      ],
      "default": "en_attente"
    },
    "valide_par": {
      "type": "string"
    },
    "valide_at": {
      "type": "string",
      "format": "date-time"
    },
    "refuse_par": {
      "type": "string"
    },
    "refuse_at": {
      "type": "string",
      "format": "date-time"
    },
    "motif_refus": {
      "type": "string"
    },
    "actif": {
      "type": "boolean",
      "default": true
    },
    "statut": {
      "type": "string",
      "enum": [
        "disponible",
        "en_course",
        "hors_ligne"
      ],
      "default": "hors_ligne"
    },
    "admin_hors_ligne": {
      "type": "boolean",
      "default": false
    },
    "manual_hors_ligne": {
      "type": "boolean",
      "default": false,
      "description": "True si le livreur s'est mis hors ligne manuellement \u2014 la remont\u00e9e auto ne s'applique pas"
    },
    "admin_statut_log": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "derniere_position_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure exactes de la derni\u00e8re mise \u00e0 jour GPS (latitude/longitude). Mis \u00e0 jour par heartbeatAuto \u00e0 chaque r\u00e9ception de coordonn\u00e9es valides."
    },
    "gps_accuracy": {
      "type": "number",
      "description": "Pr\u00e9cision GPS en m\u00e8tres au moment de la derni\u00e8re position enregistr\u00e9e. Plus c'est bas, plus c'est pr\u00e9cis."
    },
    "courses_du_jour": {
      "type": "number",
      "default": 0
    },
    "user_email": {
      "type": "string"
    },
    "vehicule": {
      "type": "string",
      "enum": [
        "moto",
        "velo",
        "voiture",
        "a_pied"
      ],
      "default": "moto"
    },
    "type_vehicule": {
      "type": "string",
      "enum": [
        "moto",
        "velo",
        "voiture",
        "a_pied"
      ],
      "default": "moto"
    },
    "numero_plaque": {
      "type": "string"
    },
    "photo_cnib_recto_url": {
      "type": "string"
    },
    "photo_cnib_verso_url": {
      "type": "string"
    },
    "photo_moto_url": {
      "type": "string"
    },
    "statut_paiement": {
      "type": "string",
      "enum": [
        "non_paye",
        "paye"
      ],
      "default": "non_paye"
    },
    "montant_paye": {
      "type": "number"
    },
    "heure_paiement": {
      "type": "string",
      "format": "date-time"
    },
    "admin_paiement": {
      "type": "string"
    },
    "code_identification": {
      "type": "string"
    },
    "app_active": {
      "type": "boolean",
      "default": false
    },
    "background_active": {
      "type": "boolean",
      "default": false,
      "description": "Foreground Service Android actif en arri\u00e8re-plan"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_active_id": {
      "type": "string"
    },
    "session_active_device": {
      "type": "string"
    },
    "session_active_date": {
      "type": "string",
      "format": "date-time"
    },
    "montant_du_silga": {
      "type": "number",
      "default": 0
    },
    "base_comptable_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de coupure comptable. Si d\u00e9finie, seules les courses livr\u00e9es apr\u00e8s cette date ET les paiements trait\u00e9s apr\u00e8s cette date entrent dans le calcul du solde. Le solde initial de la base (base_comptable_solde_initial) est ajout\u00e9. Null = comportement historique (toutes les courses et paiements)."
    },
    "base_comptable_solde_initial": {
      "type": "number",
      "default": 0,
      "description": "Solde initial (dette ou cr\u00e9dit) au moment de la base comptable. Si positif = dette initiale. Si n\u00e9gatif = cr\u00e9dit initial. Ajout\u00e9 au calcul: solde = base_comptable_solde_initial + commissions(apr\u00e8s base) - paiements(apr\u00e8s base)."
    },
    "dernier_paiement_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date du dernier r\u00e8glement enregistr\u00e9 par l'admin"
    },
    "encours": {
      "type": "number",
      "default": 0
    },
    "bloque_encours": {
      "type": "boolean",
      "default": false
    },
    "encours_bloque_at": {
      "type": "string",
      "format": "date-time"
    },
    "encours_alerte_at": {
      "type": "string",
      "format": "date-time"
    },
    "note_moyenne": {
      "type": "number",
      "default": 0
    },
    "nombre_avis": {
      "type": "number",
      "default": 0
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ],
      "default": "automatic"
    },
    "priorite_dispatch": {
      "type": "number",
      "default": 0,
      "description": "Niveau de priorit\u00e9 pour le dispatch. 0 = normal (tri par distance/GPS). 1+ = prioritaire (notifi\u00e9 en premier, peu importe la distance). Plus le chiffre est \u00e9lev\u00e9, plus le livreur est prioritaire."
    },
    "whatsapp_opt_in": {
      "type": "boolean",
      "default": false
    },
    "whatsapp_opt_in_date": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_opt_in_expire_at": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_derniere_erreur": {
      "type": "string"
    },
    "whatsapp_derniere_erreur_date": {
      "type": "string",
      "format": "date-time"
    },
    "silga_score": {
      "type": "number",
      "default": 0,
      "description": "Score SILGAPP 0-100 calcul\u00e9 \u00e0 partir des donn\u00e9es op\u00e9rationnelles (acceptation, livraison, annulations, d\u00e9lai de r\u00e9ponse, note, fiabilit\u00e9 financi\u00e8re). Mode observation uniquement \u2014 NON utilis\u00e9 dans le dispatch V2."
    },
    "silga_score_niveau": {
      "type": "string",
      "enum": [
        "excellent",
        "bon",
        "moyen",
        "faible",
        "non_calcule"
      ],
      "default": "non_calcule",
      "description": "Niveau du Silga Score: excellent (80+), bon (60-79), moyen (40-59), faible (<40). non_calcule = score jamais calcul\u00e9."
    },
    "silga_score_breakdown": {
      "type": "string",
      "description": "JSON: d\u00e9tail du score par cat\u00e9gorie (taux_acceptation, taux_livraison, taux_annulation, delai_reponse, note_moyenne, fiabilite_financiere). Pour audit et transparence."
    },
    "silga_score_calculated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date du dernier calcul du Silga Score."
    },
    "silga_score_confiance": {
      "type": "string",
      "enum": [
        "faible",
        "moyenne",
        "elevee"
      ],
      "default": "faible",
      "description": "Niveau de confiance du Silga Score bas\u00e9 sur le volume de donn\u00e9es. faible = < 5 data points (livreur potentiellement nouveau, score peu fiable). moyenne = 5-19 data points. elevee = >= 20 data points (score fiable)."
    },
    "silga_score_data_points": {
      "type": "number",
      "default": 0,
      "description": "Nombre total de points de donn\u00e9es utilis\u00e9s pour le calcul (notifications dispatch + courses livr\u00e9es + avis clients). D\u00e9termine la confiance du score."
    },
    "silga_score_anomalies": {
      "type": "string",
      "description": "JSON: tableau des anomalies d\u00e9tect\u00e9es lors du calcul (ex: score \u00e9lev\u00e9 mais taux d'annulation \u00e9lev\u00e9, score faible par manque de donn\u00e9es). Pour audit et calibration."
    }
  },
  "required": [
    "nom",
    "telephone",
    "type_livreur"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}