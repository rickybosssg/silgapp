{
  "name": "CommerceMutationJournal",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "segmented",
        "open",
        "sealed"
      ],
      "default": "ready"
    },
    "revision": {
      "type": "number",
      "default": 0
    },
    "ledger": {
      "type": "string",
      "default": "[]"
    },
    "journal_version": {
      "type": "integer",
      "description": "Protocol version:2 for segmented root/segment rows; absent for legacy singleton."
    },
    "root_id": {
      "type": "string",
      "description": "Protected configured root ID on segment rows."
    },
    "segment_ids": {
      "type": "string",
      "description": "Ordered unique segment IDs encoded as JSON on segmented root only."
    }
  },
  "required": [
    "state",
    "revision",
    "ledger"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}