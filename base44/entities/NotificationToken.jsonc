{
  "name": "NotificationToken",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur"
    },
    "token": {
      "type": "string",
      "description": "Token FCM (Firebase Cloud Messaging)"
    },
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "android",
        "ios"
      ],
      "description": "Plateforme de l'appareil"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "admin",
        "livreur",
        "client",
        "partenaire"
      ],
      "description": "Type d'utilisateur"
    },
    "livreur_id": {
      "type": "string",
      "description": "ID du livreur si user_type='livreur'"
    },
    "client_id": {
      "type": "string",
      "description": "ID du client si user_type='client'"
    },
    "device_id": {
      "type": "string",
      "description": "Identifiant stable d'installation SILGAPP (UUID g\u00e9n\u00e9r\u00e9 c\u00f4t\u00e9 natif, conserv\u00e9 en SharedPreferences). Permet de distinguer plusieurs appareils du m\u00eame utilisateur. Un seul token actif par (user_email, device_id). Vide pour les anciens tokens pr\u00e9-migration \u2014 ne jamais inventer."
    },
    "actif": {
      "type": "boolean",
      "default": true,
      "description": "Token actif ou expir\u00e9"
    },
    "derniere_utilisation": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re fois que le token a \u00e9t\u00e9 utilis\u00e9"
    },
    "derniere_notif_titre": {
      "type": "string",
      "description": "Titre de la derni\u00e8re notification envoy\u00e9e"
    },
    "derniere_notif_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la derni\u00e8re notification envoy\u00e9e"
    },
    "derniere_notif_statut": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ],
      "description": "Statut de la derni\u00e8re notification"
    },
    "fcm_error": {
      "type": "string",
      "description": "Derni\u00e8re erreur FCM re\u00e7ue"
    },
    "preferences_categories": {
      "type": "string",
      "description": "JSON: cat\u00e9gories d\u00e9sactiv\u00e9es par l'utilisateur (ex: [\"marketing\",\"info_generale\"]). Les cat\u00e9gories critiques (course, dispatch, securite) sont toujours envoy\u00e9es.",
      "default": "[]"
    }
  },
  "required": [
    "user_email",
    "token",
    "platform",
    "user_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}