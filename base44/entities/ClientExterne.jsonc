{
  "name": "ClientExterne",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom de famille du client"
    },
    "prenom": {
      "type": "string",
      "description": "Pr\u00e9nom du client"
    },
    "telephone": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone (format lisible)"
    },
    "telephone_normalized": {
      "type": "string",
      "description": "Num\u00e9ro normalis\u00e9 format international sans espace ni + (ex: 22670259008). Utilis\u00e9 pour TOUTES les recherches et la d\u00e9duplication."
    },
    "email": {
      "type": "string",
      "description": "Adresse email"
    },
    "country_code": {
      "type": "string",
      "description": "Code pays ISO 2 lettres (ex: BF, CI, TG). Dynamique : aucun pays cod\u00e9 en dur."
    },
    "ville": {
      "type": "string",
      "description": "Ville du client (d\u00e9tect\u00e9e par GPS ou saisie)"
    },
    "quartier": {
      "type": "string",
      "description": "Quartier de r\u00e9sidence"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude actuelle"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude actuelle"
    },
    "actif": {
      "type": "boolean",
      "default": true,
      "description": "Compte actif ou bloqu\u00e9"
    },
    "bloque_frais_annulation": {
      "type": "boolean",
      "default": false,
      "description": "Client bloqu\u00e9 pour frais d'annulation impay\u00e9s"
    },
    "user_email": {
      "type": "string",
      "description": "Email du compte utilisateur li\u00e9"
    },
    "app_active": {
      "type": "boolean",
      "default": false,
      "description": "Application actuellement ouverte"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re activit\u00e9 dans l'application (heartbeat)"
    },
    "session_active_id": {
      "type": "string",
      "description": "ID de la session active unique. Une seule session autoris\u00e9e par client."
    },
    "session_active_device": {
      "type": "string",
      "description": "Device ID de la session active"
    },
    "session_active_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de cr\u00e9ation de la session active"
    },
    "code_promo_utilise": {
      "type": "string",
      "description": "Code promo saisi \u00e0 l'inscription (usage unique)"
    },
    "code_promo_id": {
      "type": "string",
      "description": "ID du CodePromo utilis\u00e9"
    },
    "premiere_course_faite": {
      "type": "boolean",
      "default": false,
      "description": "Le client a d\u00e9j\u00e0 effectu\u00e9 sa premi\u00e8re course (plus de r\u00e9duction possible)"
    },
    "statut_crm": {
      "type": "string",
      "enum": [
        "actif",
        "inactif",
        "vip",
        "nouveau"
      ],
      "default": "nouveau",
      "description": "Statut CRM du client (actif, inactif, vip, nouveau)"
    },
    "nb_courses_total": {
      "type": "number",
      "default": 0,
      "description": "Nombre total de courses LIVR\u00c9ES (tous types confondus). Mis \u00e0 jour uniquement quand une course passe \u00e0 livree."
    },
    "nb_courses_admin": {
      "type": "number",
      "default": 0,
      "description": "Nombre de courses administratives LIVR\u00c9ES"
    },
    "montant_total_depense": {
      "type": "number",
      "default": 0,
      "description": "Montant total d\u00e9pens\u00e9 par le client (FCFA) \u2014 calcul\u00e9 uniquement sur les courses LIVR\u00c9ES"
    },
    "derniere_course_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la derni\u00e8re course livr\u00e9e"
    },
    "dernier_quartier_depart": {
      "type": "string",
      "description": "Dernier quartier de d\u00e9part utilis\u00e9 (course livr\u00e9e)"
    },
    "dernier_quartier_arrivee": {
      "type": "string",
      "description": "Dernier quartier de livraison utilis\u00e9 (course livr\u00e9e)"
    },
    "quartiers_utilises": {
      "type": "string",
      "description": "JSON: [{quartier, count}] quartiers les plus utilis\u00e9s (courses livr\u00e9es uniquement)"
    },
    "type_colis_frequent": {
      "type": "string",
      "description": "Type de colis le plus fr\u00e9quent"
    },
    "notes_admin": {
      "type": "string",
      "description": "Notes administratives sur le client"
    },
    "roles": {
      "type": "string",
      "description": "JSON: tableau des r\u00f4les (client, expediteur, destinataire)"
    },
    "est_expediteur": {
      "type": "boolean",
      "default": false,
      "description": "Ce client a d\u00e9j\u00e0 \u00e9t\u00e9 exp\u00e9diteur"
    },
    "est_destinataire": {
      "type": "boolean",
      "default": false,
      "description": "Ce client a d\u00e9j\u00e0 \u00e9t\u00e9 destinataire"
    },
    "cree_via_crm": {
      "type": "boolean",
      "default": false,
      "description": "True si le client a \u00e9t\u00e9 cr\u00e9\u00e9 automatiquement par le CRM lors d'une course admin"
    }
  },
  "required": [
    "nom",
    "telephone"
  ]
}