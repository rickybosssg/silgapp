{
  "name": "CommandeBoutique",
  "type": "object",
  "properties": {
    "boutique_id": {
      "type": "string",
      "description": "ID de la boutique"
    },
    "boutique_nom": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "ClientExterne ID du client"
    },
    "client_nom": {
      "type": "string"
    },
    "client_telephone": {
      "type": "string"
    },
    "pays_code": {
      "type": "string",
      "enum": [
        "BF",
        "CI",
        "TG",
        "BJ",
        "SN",
        "ML",
        "GN",
        "NE",
        "GH"
      ],
      "description": "Code pays \u2014 isolation stricte"
    },
    "items": {
      "type": "string",
      "description": "JSON: [{id, nom, prix, quantite, photo_url}]"
    },
    "total": {
      "type": "number",
      "description": "Total produits uniquement (pas de frais livraison)"
    },
    "adresse_livraison": {
      "type": "string"
    },
    "quartier_livraison": {
      "type": "string"
    },
    "gps_lat": {
      "type": "number"
    },
    "gps_lng": {
      "type": "number"
    },
    "note_client": {
      "type": "string"
    },
    "preuve_paiement_url": {
      "type": "string",
      "description": "Photo preuve de paiement Orange Money"
    },
    "statut": {
      "type": "string",
      "enum": [
        "commande_envoyee",
        "commande_recue",
        "paiement_verification",
        "paiement_valide",
        "paiement_refuse",
        "en_preparation",
        "prete_recuperation",
        "livreur_assigne",
        "commande_recuperee",
        "en_livraison",
        "livree",
        "annulee"
      ],
      "default": "commande_envoyee"
    },
    "course_id": {
      "type": "string",
      "description": "ID de la CourseExterne cr\u00e9\u00e9e quand pr\u00eate"
    },
    "partenaire_id": {
      "type": "string",
      "description": "User ID du partenaire (filtrage rapide)"
    },
    "commission_pct": {
      "type": "number"
    },
    "commission_montant": {
      "type": "number"
    },
    "motif_annulation": {
      "type": "string"
    },
    "commerce_payment_proof_id": {
      "type": "string",
      "description": "Protected private payment proof reference set by the commerce server."
    },
    "prix_livraison_propose": {
      "type": "number",
      "description": "Prix de livraison propose par le client, distinct du total produits et payable directement au livreur."
    },
    "workflow_livraison": {
      "type": "string",
      "enum": [
        "client_price_v1"
      ],
      "description": "Contrat serveur additif pour les nouvelles commandes avec prix livraison client. Absent sur les commandes historiques."
    },
    "devise": {
      "type": "string",
      "description": "Devise Country attestee lors de la confirmation client. Aucun defaut ni conversion des commandes historiques."
    },
    "loyalty_identity_version": {
      "type": "number",
      "enum": [
        1
      ],
      "description": "Optional prospective native client proof v1. Server writes only; see reader-contract.md.",
      "rls": {
        "write": false
      }
    },
    "loyalty_identity_beneficiary_user_id": {
      "type": "string",
      "description": "Optional prospective native client proof v1. Server writes only; see reader-contract.md.",
      "rls": {
        "write": false
      }
    },
    "loyalty_identity_client_profile_id": {
      "type": "string",
      "description": "Optional prospective native client proof v1. Server writes only; see reader-contract.md.",
      "rls": {
        "write": false
      }
    },
    "loyalty_identity_country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Optional prospective native client proof v1. Server writes only; see reader-contract.md.",
      "rls": {
        "write": false
      }
    },
    "loyalty_identity_attested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional prospective native client proof v1. Server writes only; see reader-contract.md.",
      "rls": {
        "write": false
      }
    },
    "loyalty_identity_source_kind": {
      "type": "string",
      "enum": [
        "direct",
        "order",
        "pharmacy"
      ],
      "description": "Optional prospective native client proof v1. Server writes only; see reader-contract.md.",
      "rls": {
        "write": false
      }
    },
    "loyalty_identity_source_id": {
      "type": "string",
      "description": "Optional prospective native client proof v1. Server writes only; see reader-contract.md.",
      "rls": {
        "write": false
      }
    },
    "loyalty_identity_pharmacy_id": {
      "type": "string",
      "description": "Optional prospective native client proof v1. Server writes only; see reader-contract.md.",
      "rls": {
        "write": false
      }
    },
    "partner_alert_ack_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": false
      }
    },
    "partner_alert_ack_by": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "partner_alert_request_id": {
      "type": "string",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "boutique_id",
    "client_id",
    "pays_code",
    "total",
    "statut"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}