{
  "name": "CommissionConfig",
  "type": "object",
  "properties": {
    "pays_code": {
      "type": "string",
      "description": "Code pays ISO 2 lettres \u2014 isolation stricte (ex: BF, CI, NG, MA). Dynamique : aucun pays cod\u00e9 en dur."
    },
    "commission_boutique_defaut": {
      "type": "number",
      "default": 10,
      "description": "Commission par d\u00e9faut boutiques (%)"
    },
    "commission_restaurant_defaut": {
      "type": "number",
      "default": 10,
      "description": "Commission par d\u00e9faut restaurants (%)"
    },
    "commission_pharmacie_defaut": {
      "type": "number",
      "default": 10,
      "description": "Commission par d\u00e9faut pharmacies (%)"
    }
  },
  "required": [
    "pays_code"
  ]
}