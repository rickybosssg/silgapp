{
  "type": "object",
  "name": "User",
  "properties": {
    "role": {
      "type": "string",
      "description": "Rôle de l'utilisateur",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "admin_type": {
      "type": "string",
      "description": "Type d'admin : global (tous les pays) ou pays (un seul pays)",
      "enum": [
        "global",
        "pays"
      ],
      "default": "global"
    },
    "country_code": {
      "type": "string",
      "description": "Code pays ISO de l'admin pays (ex: BF, CI). Vide si admin global.",
      "enum": [
        "BF",
        "CI",
        "TG",
        "BJ",
        "SN",
        "ML",
        "GN",
        "NE"
      ]
    },
    "silgapp_role": {
      "type": "string",
      "description": "Rôle métier SILGAPP persistant en base de données. Définit le dashboard affiché : client, livreur, partenaire, agent_saisie (accès limité au formulaire de création de course admin), ou admin_entreprise (dashboard entreprise privé). Indépendant du cache/localStorage — survit à la désinstallation et au changement d'appareil.",
      "enum": [
        "client",
        "livreur",
        "partenaire",
        "agent_saisie",
        "admin_entreprise"
      ]
    },
    "can_create_admin_course": {
      "type": "boolean",
      "description": "Permission dédiée : autorise cet utilisateur à créer des courses administratives via /admin/creer-course, SANS lui donner le rôle admin complet. Vérifiée côté backend dans creerCourseAdmin. Doit être définie par un admin (pas auto-modifiable par l'utilisateur).",
      "default": false
    },
    "enterprise_id": {
      "type": "string",
      "description": "ID financier IMMUABLE de l'entreprise à laquelle cet utilisateur est rattaché. Null = utilisateur du réseau public SILGAPP. Résolu côté backend UNIQUEMENT (jamais fourni par le frontend). Un Admin Entreprise ne peut pas changer son enterprise_id. Un Super Admin SILGAPP n'a pas d'enterprise_id (null = réseau public). Permet la RLS pour isoler les données par entreprise. DEFAULT null obligatoire — sans cette valeur explicite, la RLS CourseExterne (data.enterprise_id = {{user.data.enterprise_id}}) ne résout pas vers null pour les users publics, rendant les courses publiques invisibles.",
      "default": null
    }
  },
  "required": [
    "country_code",
    "silgapp_role"
  ]
}