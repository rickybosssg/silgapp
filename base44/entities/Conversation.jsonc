{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participants": {
      "type": "string",
      "description": "JSON: [{type: 'client'|'livreur'|'admin'|'partenaire', id: string, name: string}]"
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tableau des User.id autoris\u00e9s \u00e0 acc\u00e9der \u00e0 cette conversation. R\u00e9solu c\u00f4t\u00e9 backend UNIQUEMENT (jamais fourni par le frontend). Sert de base \u00e0 la RLS read/update quand security_status=secured."
    },
    "security_status": {
      "type": "string",
      "enum": [
        "pending",
        "secured"
      ],
      "default": "pending",
      "description": "Statut de s\u00e9curit\u00e9. pending = cr\u00e9ation non s\u00e9curis\u00e9e (seul le cr\u00e9ateur peut lire via created_by_id). secured = participant_user_ids r\u00e9solu c\u00f4t\u00e9 backend (seuls les participants peuvent lire). Toute cr\u00e9ation directe via SDK d\u00e9marre en pending \u2014 l'automation backfillConversationParticipants passe en secured apr\u00e8s r\u00e9solution."
    },
    "last_message": {
      "type": "string"
    },
    "last_message_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_sender_name": {
      "type": "string"
    },
    "last_sender_type": {
      "type": "string",
      "enum": [
        "client",
        "livreur",
        "admin",
        "partenaire"
      ]
    },
    "admin_last_read_date": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "group_type": {
      "type": "string",
      "enum": [
        "direct",
        "group"
      ],
      "default": "direct"
    },
    "whatsapp_phone": {
      "type": "string",
      "description": "Numero WhatsApp du client (format international sans +)"
    },
    "silgapp_from_number": {
      "type": "string",
      "description": "Numero WhatsApp SILGAPP qui a recu le message (ex: whatsapp:+22655483838). Permet d'envoyer les reponses et notifications depuis le bon numero en mode dual-number (VENUS vs principal)."
    },
    "source": {
      "type": "string",
      "enum": [
        "app",
        "whatsapp"
      ],
      "default": "app",
      "description": "Origine de la conversation"
    },
    "venus_active": {
      "type": "boolean",
      "default": true,
      "description": "True si Venus repond automatiquement, False si un admin a pris la main"
    },
    "assigned_admin_email": {
      "type": "string",
      "description": "Email de l'admin qui a pris la main"
    },
    "ville": {
      "type": "string",
      "description": "Ville du client (si detectee)"
    },
    "country_code": {
      "type": "string",
      "enum": [
        "BF",
        "CI",
        "TG",
        "BJ",
        "SN",
        "ML",
        "GN",
        "NE",
        "GH",
        ""
      ],
      "default": "",
      "description": "Code pays detecte depuis le numero WhatsApp"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Conversation archivee par l'admin"
    },
    "venus_pending_course": {
      "type": "string",
      "description": "JSON: donnees de course en cours de collecte par Venus (avant creation)"
    }
  },
  "required": [
    "participants"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.security_status": "secured"
            },
            {
              "data.participant_user_ids": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.security_status": "pending"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.security_status": "secured"
            },
            {
              "data.participant_user_ids": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}