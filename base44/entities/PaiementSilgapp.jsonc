{
  "name": "PaiementSilgapp",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de utilisateur"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "client",
        "livreur",
        "boutique",
        "restaurant"
      ],
      "description": "Type d utilisateur"
    },
    "user_id": {
      "type": "string",
      "description": "ID de l entite (livreur_id, client_id, boutique_id, restaurant_id)"
    },
    "user_nom": {
      "type": "string"
    },
    "user_telephone": {
      "type": "string"
    },
    "type_dette": {
      "type": "string",
      "enum": [
        "commission_livreur",
        "frais_annulation_client",
        "commission_boutique",
        "commission_restaurant"
      ],
      "description": "Type de dette envers SILGAPP"
    },
    "montant_du": {
      "type": "number",
      "description": "Montant du au moment de l envoi"
    },
    "montant_paye": {
      "type": "number",
      "description": "Montant declare paye par l utilisateur"
    },
    "ancien_solde": {
      "type": "number",
      "description": "Solde du livreur AVANT ce paiement (pour audit)"
    },
    "nouveau_solde": {
      "type": "number",
      "description": "Solde du livreur APRES ce paiement (pour audit)"
    },
    "courses_concernees": {
      "type": "string",
      "description": "JSON: tableau des IDs de courses concernees par ce paiement (vide si paiement global sur solde)"
    },
    "type_paiement": {
      "type": "string",
      "enum": [
        "course_unique",
        "multi_courses",
        "solde_global",
        "partiel"
      ],
      "description": "Type de paiement: course_unique (1 course), multi_courses (plusieurs courses), solde_global (toutes les courses), partiel (paiement partiel)"
    },
    "reference_paiement": {
      "type": "string",
      "description": "Reference unique du paiement (generee automatiquement)"
    },
    "numero_depot": {
      "type": "string",
      "default": "+226 66 92 51 90",
      "description": "Numero utilise pour le depot"
    },
    "preuve_url": {
      "type": "string",
      "description": "Image ou PDF de la preuve de depot"
    },
    "preuve_type": {
      "type": "string",
      "description": "Type MIME de la preuve de depot"
    },
    "request_id": {
      "type": "string",
      "description": "Identifiant idempotent unique de la soumission"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en_attente",
        "traite",
        "refuse"
      ],
      "default": "en_attente"
    },
    "traite_par": {
      "type": "string",
      "description": "Email admin ayant traite"
    },
    "traite_at": {
      "type": "string",
      "format": "date-time"
    },
    "date_envoi": {
      "type": "string",
      "format": "date-time"
    },
    "motif_refus": {
      "type": "string"
    },
    "country_code": {
      "type": "string",
      "enum": [
        "BF",
        "CI",
        "TG",
        "BJ",
        "SN",
        "ML",
        "GN",
        "NE",
        "GH"
      ]
    }
  },
  "required": [
    "user_email",
    "user_type",
    "user_id",
    "user_nom",
    "montant_paye",
    "statut"
  ]
}