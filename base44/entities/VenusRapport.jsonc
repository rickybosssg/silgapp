{
  "name": "VenusRapport",
  "type": "object",
  "properties": {
    "type_rapport": {
      "type": "string",
      "enum": [
        "quotidien",
        "hebdomadaire",
        "mensuel"
      ],
      "description": "Type de rapport"
    },
    "sous_type": {
      "type": "string",
      "enum": [
        "matin",
        "soir",
        "journee",
        "hebdomadaire"
      ],
      "description": "Sous-type: matin (bilan veille), soir (bilan jour), journee (point intelligent), hebdomadaire"
    },
    "country_code": {
      "type": "string",
      "description": "Pays concern\u00e9 ou ALL pour global"
    },
    "periode_debut": {
      "type": "string",
      "format": "date",
      "description": "D\u00e9but de la p\u00e9riode"
    },
    "periode_fin": {
      "type": "string",
      "format": "date",
      "description": "Fin de la p\u00e9riode"
    },
    "contenu_json": {
      "type": "string",
      "description": "Contenu du rapport en JSON stringifi\u00e9"
    },
    "resume": {
      "type": "string",
      "description": "R\u00e9sum\u00e9 textuel d\u00e9terministe affich\u00e9 \u00e0 Eric"
    },
    "statut_lecture": {
      "type": "string",
      "enum": [
        "non_lu",
        "lu"
      ],
      "default": "non_lu",
      "description": "Statut de lecture par l'admin"
    },
    "lu_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de lecture par l'admin"
    },
    "nb_questions": {
      "type": "number",
      "default": 0
    },
    "nb_conversations": {
      "type": "number",
      "default": 0
    },
    "nb_resolues": {
      "type": "number",
      "default": 0
    },
    "top_categories": {
      "type": "string"
    },
    "problemes_detectes": {
      "type": "string"
    },
    "recommandations": {
      "type": "string"
    },
    "genere_par": {
      "type": "string"
    }
  },
  "required": [
    "type_rapport",
    "country_code",
    "periode_debut",
    "periode_fin"
  ]
}