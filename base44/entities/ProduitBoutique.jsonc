{
  "name": "ProduitBoutique",
  "type": "object",
  "properties": {
    "boutique_id": {
      "type": "string",
      "description": "ID de la boutique propri\u00e9taire"
    },
    "nom": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo principale (r\u00e9trocompatibilit\u00e9)"
    },
    "photos_urls": {
      "type": "string",
      "description": "JSON: tableau des URLs des photos (galerie)"
    },
    "video_url": {
      "type": "string",
      "description": "URL de la courte vid\u00e9o du produit"
    },
    "prix": {
      "type": "number"
    },
    "devise": {
      "type": "string",
      "default": "FCFA"
    },
    "categorie": {
      "type": "string",
      "description": "Cat\u00e9gorie de produit"
    },
    "disponible": {
      "type": "boolean",
      "default": true
    },
    "actif": {
      "type": "boolean",
      "default": true
    },
    "validation": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse"
      ],
      "default": "en_attente",
      "description": "Statut de validation par l'admin"
    },
    "motif_refus": {
      "type": "string",
      "description": "Motif de refus du produit"
    },
    "valide_par": {
      "type": "string",
      "description": "Email admin ayant valid\u00e9/refus\u00e9"
    },
    "valide_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de validation"
    }
  },
  "required": [
    "boutique_id",
    "nom",
    "prix"
  ]
}