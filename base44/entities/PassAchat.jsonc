{
  "name": "PassAchat",
  "type": "object",
  "properties": {
    "livreur_id": {
      "type": "string",
      "description": "ID du livreur qui ach\u00e8te le Pass"
    },
    "livreur_user_email": {
      "type": "string",
      "description": "Email du compte User du livreur. R\u00e9solu c\u00f4t\u00e9 backend UNIQUEMENT. Permet la RLS read pour que le livreur voie ses achats."
    },
    "pass_offer_id": {
      "type": "string",
      "description": "ID du PassOffer achet\u00e9"
    },
    "pass_offer_nom": {
      "type": "string",
      "description": "Nom du Pass au moment de l'achat (snapshot)"
    },
    "duree_jours": {
      "type": "number",
      "description": "Dur\u00e9e du Pass en jours (snapshot au moment de l'achat)"
    },
    "montant_paye": {
      "type": "number",
      "description": "Montant pay\u00e9 par le livreur pour acheter le Pass"
    },
    "devise": {
      "type": "string",
      "default": "FCFA"
    },
    "preuve_url": {
      "type": "string",
      "description": "URL de la preuve de paiement (capture/photo)"
    },
    "preuve_type": {
      "type": "string",
      "default": "image"
    },
    "request_id": {
      "type": "string",
      "description": "Cl\u00e9 idempotente (UUID) unique par tentative d'achat. Emp\u00eache les doublons."
    },
    "country_code": {
      "type": "string",
      "description": "Code pays du livreur (ex: BF, CI)"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse",
        "annule"
      ],
      "default": "en_attente",
      "description": "Statut de l'achat. en_attente = preuve envoy\u00e9e, en attente de validation admin. valide = Pass activ\u00e9. refuse = preuve rejet\u00e9e. annule = Pass valid\u00e9 puis annul\u00e9 par l'admin (d\u00e9sactiv\u00e9 imm\u00e9diatement, historique conserv\u00e9)."
    },
    "valide_par": {
      "type": "string",
      "description": "Email de l'admin ayant valid\u00e9 l'achat"
    },
    "valide_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure de validation par l'admin"
    },
    "refuse_par": {
      "type": "string",
      "description": "Email de l'admin ayant refus\u00e9 l'achat"
    },
    "refuse_at": {
      "type": "string",
      "format": "date-time"
    },
    "refuse_raison": {
      "type": "string"
    },
    "annule_par": {
      "type": "string",
      "description": "Email de l'admin ayant annul\u00e9 le Pass apr\u00e8s validation"
    },
    "annule_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure d'annulation du Pass par l'admin. Le Pass est imm\u00e9diatement d\u00e9sactiv\u00e9 \u00e0 partir de cette date."
    },
    "motif_annulation": {
      "type": "string",
      "description": "Motif d'annulation saisi par l'admin (erreur de validation, preuve incorrecte, probl\u00e8me op\u00e9rationnel, etc.)"
    },
    "debut_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure de d\u00e9but du Pass. = valide_at. Le Pass est actif \u00e0 partir de cette date."
    },
    "expiration_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure d'expiration ORIGINALE du Pass = debut_at + duree_jours. Conserv\u00e9e m\u00eame apr\u00e8s annulation pour l'historique. Au-del\u00e0, le Pass n'est plus actif."
    },
    "date_demande": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure de la demande d'achat par le livreur"
    }
  },
  "required": [
    "livreur_id",
    "pass_offer_id",
    "montant_paye",
    "statut"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.livreur_user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}