{
  "name": "GrowthSpend",
  "type": "object",
  "properties": {
    "moteur": {
      "type": "string",
      "enum": [
        "publicite",
        "prime_promo",
        "reactivation",
        "relance_premiere_course",
        "rappels_habitude"
      ],
      "description": "Moteur Growth ayant engag\u00e9 la d\u00e9pense"
    },
    "type_depense": {
      "type": "string",
      "enum": [
        "pub_impression",
        "pub_clic",
        "prime_livreur",
        "prime_client",
        "whatsapp_credit",
        "sms_credit",
        "autre"
      ],
      "description": "Type de d\u00e9pense Growth"
    },
    "montant": {
      "type": "number",
      "description": "Montant r\u00e9ellement d\u00e9pens\u00e9. Pour les enregistrements cr\u00e9\u00e9s AVANT la correction mon\u00e9taire du 2026-10-03, ce champ peut contenir une valeur en USD (moteur=publicite, idempotency_key commence par 'meta_spend_'). Pour les nouveaux enregistrements, ce champ contient le montant original dans la devise source (voir currency_original). Le moteur utilise 'amount_fcfa' pour tous les calculs budg\u00e9taires."
    },
    "devise": {
      "type": "string",
      "default": "FCFA"
    },
    "amount_original": {
      "type": "number",
      "description": "Montant original dans la devise source (ex: 83.00 pour 83 USD). Null pour les enregistrements historiques ant\u00e9rieurs au 2026-10-03."
    },
    "currency_original": {
      "type": "string",
      "description": "Devise source originale (ex: USD, EUR). Null pour les enregistrements historiques. 'FCFA' pour les d\u00e9penses directement en FCFA (primes, r\u00e9activation, etc.)."
    },
    "amount_fcfa": {
      "type": "number",
      "description": "Montant converti en FCFA. C'est le champ utilis\u00e9 par TOUS les calculs budg\u00e9taires de l'Autopilote (sous-plafonds, plafond global, CAC, comparaison des exp\u00e9riences, dashboard). Null pour les enregistrements historiques \u2014 le moteur applique une conversion \u00e0 la vol\u00e9e (montant \u00d7 600) pour les enregistrements meta_spend_ sans amount_fcfa."
    },
    "conversion_rate": {
      "type": "number",
      "description": "Taux de conversion utilis\u00e9 (ex: 600 pour 1 USD = 600 FCFA). Null pour les enregistrements historiques."
    },
    "converted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure de la conversion. Null pour les enregistrements historiques."
    },
    "country_code": {
      "type": "string",
      "description": "Code pays (ex: BF, CI). Vide = global."
    },
    "campagne_id": {
      "type": "string",
      "description": "ID de la campagne li\u00e9e (ReactivationCampaign, PushCampagne, etc.) si applicable."
    },
    "reference_id": {
      "type": "string",
      "description": "ID de l'entit\u00e9 li\u00e9e (PrimePromo, HabitReminder, etc.) si applicable."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Cl\u00e9 d'idempotencit\u00e9 pour \u00e9viter les doublons de d\u00e9pense. Doit \u00eatre unique par d\u00e9pense."
    },
    "description_depense": {
      "type": "string",
      "description": "Description libre de la d\u00e9pense."
    },
    "statut": {
      "type": "string",
      "enum": [
        "engagee",
        "payee",
        "annulee"
      ],
      "default": "engagee",
      "description": "engagee = d\u00e9pense engag\u00e9e mais non encore pay\u00e9e. payee = paiement confirm\u00e9. annulee = d\u00e9pense annul\u00e9e (n'est pas compt\u00e9e dans le r\u00e9el)."
    },
    "date_depense": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure de la d\u00e9pense."
    }
  },
  "required": [
    "moteur",
    "type_depense",
    "montant",
    "statut",
    "date_depense"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}