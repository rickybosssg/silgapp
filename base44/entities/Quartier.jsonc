{
  "name": "Quartier",
  "type": "object",
  "properties": {
    "country_code": {
      "type": "string",
      "description": "Code pays ISO 2 lettres (ex: BF, CI, TG). Dynamique : aucun pays cod\u00e9 en dur."
    },
    "ville": {
      "type": "string",
      "description": "Ville du quartier (ex: Ouagadougou, Abidjan, Lom\u00e9)"
    },
    "nom": {
      "type": "string",
      "description": "Nom technique interne du quartier (peut inclure un num\u00e9ro de zone: Karpala, Karpala 2)"
    },
    "nom_affiche": {
      "type": "string",
      "description": "Nom visible par le client (regroupement d'affichage). Si deux zones ont le m\u00eame nom_affiche, une seule ligne appara\u00eet dans l'autocompl\u00e9tion. Ex: Karpala et Karpala 2 ont tous deux nom_affiche='Karpala'. Si vide, utilise 'nom'."
    },
    "quartier_parent": {
      "type": "string",
      "description": "Nom du quartier parent pour le regroupement interne. Si d\u00e9fini, ce quartier fait partie d'un groupe de zones GPS. Le GPS du quartier n'est qu'un point de secours \u2014 la position exacte doit venir du GPS client ou de la carte. Ex: 'Karpala' pour la zone 'Karpala 2'."
    },
    "latitude": {
      "type": "number",
      "description": "Latitude approximative du centre de la zone"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude approximative du centre de la zone"
    },
    "variantes": {
      "type": "string",
      "description": "Variantes orthographiques s\u00e9par\u00e9es par des virgules (ex: Ouaga 2000, Ouaga2000)"
    },
    "actif": {
      "type": "boolean",
      "default": true,
      "description": "Quartier actif pour le dispatch"
    }
  },
  "required": [
    "country_code",
    "ville",
    "nom",
    "latitude",
    "longitude"
  ]
}