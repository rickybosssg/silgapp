{
  "name": "Country",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Code ISO 2 lettres du pays (ex: BF, CI, TG, BJ, SN)"
    },
    "nom": {
      "type": "string",
      "description": "Nom du pays en fran\u00e7ais"
    },
    "nom_local": {
      "type": "string",
      "description": "Nom du pays dans sa langue locale (ex: Burkina)"
    },
    "indicatif": {
      "type": "string",
      "description": "Indicatif t\u00e9l\u00e9phonique (ex: +226, +225)"
    },
    "devise": {
      "type": "string",
      "default": "FCFA",
      "description": "Code devise ISO (ex: XOF, GHS, GNF)"
    },
    "devise_symbole": {
      "type": "string",
      "default": "FCFA",
      "description": "Symbole affich\u00e9 (ex: FCFA, \u20b5, GNF)"
    },
    "fuseau_horaire": {
      "type": "string",
      "default": "Africa/Ouagadougou",
      "description": "Fuseau horaire IANA (ex: Africa/Abidjan, Africa/Accra)"
    },
    "langues_officielles": {
      "type": "string",
      "description": "JSON: tableau des codes langues officielles (ex: [\"fr\"])"
    },
    "langues_secondaires": {
      "type": "string",
      "description": "JSON: tableau des codes langues secondaires (ex: [\"moore\",\"dioula\"])"
    },
    "langue_principale": {
      "type": "string",
      "default": "fr",
      "description": "Code langue principale utilis\u00e9e par VENUS"
    },
    "format_numero": {
      "type": "string",
      "description": "Format des num\u00e9ros locaux (ex: XX XX XX XX)"
    },
    "format_adresse": {
      "type": "string",
      "enum": [
        "quartier_rue",
        "rue_numero",
        "landmark",
        "gps_seul"
      ],
      "default": "quartier_rue",
      "description": "Format d'adresse privil\u00e9gi\u00e9 dans ce pays"
    },
    "modes_paiement": {
      "type": "string",
      "description": "JSON: tableau des modes de paiement disponibles (ex: [\"orange_money\",\"moov\",\"especes\",\"wave\"])"
    },
    "prix_par_km": {
      "type": "number",
      "default": 100,
      "description": "Tarif en devise locale par km parcouru"
    },
    "prix_minimum": {
      "type": "number",
      "default": 500,
      "description": "Prix minimum d'une course dans ce pays"
    },
    "prix_suggeres_client": {
      "type": "string",
      "description": "JSON: tableau des montants sugg\u00e9r\u00e9s au client lors de la cr\u00e9ation de course (ex: [1500, 2000]). Dynamique par pays."
    },
    "commission_pct": {
      "type": "number",
      "description": "Pourcentage de commission Silga configure pour ce pays"
    },
    "seuil_encours_max": {
      "type": "number",
      "default": 5000,
      "description": "Seuil d'encours maximum avant blocage automatique du livreur (en devise locale)"
    },
    "seuil_alerte_encours_pct": {
      "type": "number",
      "default": 80,
      "description": "Pourcentage du seuil d'encours \u00e0 partir duquel une alerte est envoy\u00e9e au livreur (d\u00e9faut 80%)"
    },
    "gps_expire_seuil_min": {
      "type": "number",
      "default": 30,
      "description": "D\u00e9lai maximum (en minutes) avant qu'un GPS livreur soit consid\u00e9r\u00e9 comme expir\u00e9 c\u00f4t\u00e9 backend. Un livreur avec GPS > cette valeur est exclu du dispatch (sauf prioritaires). D\u00e9faut 30 min."
    },
    "gps_max_stale_min": {
      "type": "number",
      "default": 120,
      "description": "D\u00e9lai maximum (en minutes) avant exclusion d\u00e9finitive du dispatch pour GPS trop ancien. Au-del\u00e0, m\u00eame les livreurs non-prioritaires avec GPS sont exclus. D\u00e9faut 120 min (2h)."
    },
    "ville_principale": {
      "type": "string",
      "description": "Ville principale d'op\u00e9ration (ex: Ouagadougou, Abidjan)"
    },
    "latitude_centre": {
      "type": "number",
      "description": "Latitude du centre de la ville principale"
    },
    "longitude_centre": {
      "type": "number",
      "description": "Longitude du centre de la ville principale"
    },
    "rayon_km": {
      "type": "number",
      "default": 30,
      "description": "Rayon d'op\u00e9ration en km autour du centre"
    },
    "horaires_service": {
      "type": "string",
      "description": "JSON: {debut: \"06:00\", fin: \"23:00\", jours_ouvrables: [\"lun\",\"mar\",...]}"
    },
    "politiques_locales": {
      "type": "string",
      "description": "JSON: r\u00e8gles sp\u00e9cifiques au pays (annulation, remboursement, etc.)"
    },
    "support_telephone": {
      "type": "string",
      "description": "Num\u00e9ro de support local WhatsApp"
    },
    "personnalite_id": {
      "type": "string",
      "description": "ID de la VenusPersonality assign\u00e9e \u00e0 ce pays (vide = personnalit\u00e9 par d\u00e9faut)"
    },
    "brand_id": {
      "type": "string",
      "description": "ID de la VenusBrand (marque) assign\u00e9e \u00e0 ce pays (vide = SILGAPP par d\u00e9faut)"
    },
    "actif": {
      "type": "boolean",
      "default": false,
      "description": "Pays actif pour les op\u00e9rations SILGAPP"
    },
    "emoji_flag": {
      "type": "string",
      "description": "Emoji drapeau du pays"
    },
    "ordre": {
      "type": "number",
      "default": 99,
      "description": "Ordre d'affichage dans les listes"
    }
  },
  "required": [
    "code",
    "nom",
    "indicatif"
  ]
}