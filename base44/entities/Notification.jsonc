{
  "name": "Notification",
  "type": "object",
  "properties": {
    "titre": {
      "type": "string",
      "description": "Titre de la notification"
    },
    "message": {
      "type": "string",
      "description": "Contenu de la notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "generic",
        "test",
        "nouvelle_course",
        "nouvelle_course_venus",
        "course_assignee",
        "course_acceptee",
        "course_refusee",
        "colis_recupere",
        "en_livraison",
        "course_livree",
        "course_bloquee",
        "course_annulee",
        "batterie_faible",
        "livreur_hors_ligne",
        "paiement_valide",
        "course_proximite",
        "rappel_reponse",
        "alerte_critique_dispatch",
        "message_client",
        "incident_detecte",
        "course_modifiee"
      ],
      "description": "Type de notification"
    },
    "course_id": {
      "type": "string",
      "description": "ID de la course liee"
    },
    "destinataire_email": {
      "type": "string",
      "description": "Email du destinataire"
    },
    "deduplication_key": {
      "type": "string",
      "description": "Cl\u00e9 anti-doublon (ex: COURSE_DISPATCH_<courseId>_<livreurId>). Emp\u00eache les notifications dupliqu\u00e9es pour le m\u00eame \u00e9v\u00e9nement. Deux \u00e9v\u00e9nements diff\u00e9rents (ex: dispatch vs rappel) utilisent des cl\u00e9s diff\u00e9rentes. Un retry du m\u00eame \u00e9v\u00e9nement est bloqu\u00e9."
    },
    "lue": {
      "type": "boolean",
      "default": false,
      "description": "Notification lue ou non"
    }
  },
  "required": [
    "titre",
    "message",
    "type"
  ]
}