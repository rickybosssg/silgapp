{
  "name": "Dispatch Auto Externe",
  "description": "Lancer automatiquement la recherche d'un livreur externe quand une course est cr\u00e9\u00e9e",
  "trigger": {
    "condition": "${ (.trigger.data.statut == \"recherche_livreur\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "CourseExterne"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dispatch_auto_externe",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dispatchExterneAuto",
            "args": {
              "action": "lancer_recherche_auto"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "dispatchExterneAuto"
  }
}