{
  "name": "VENUS Supervision \u2014 Sauvegarde Auto",
  "description": "Sauvegarde automatique quotidienne des donn\u00e9es VENUS (knowledge, scenarios, workflows, m\u00e9moire) \u00e0 3h du matin",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 1 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "venus_supervision_sauvegarde_auto",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "supervisionAutoVenus",
            "args": {
              "task": "auto_backup"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "supervisionAutoVenus"
  }
}