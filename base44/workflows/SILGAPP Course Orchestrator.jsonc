{
  "name": "SILGAPP Course Orchestrator",
  "description": "Routeur unique pour TOUS les \u00e9v\u00e9nements CourseExterne (create + update). Remplace 4 automations par 1 seule. Modules: dispatchExterneAuto, notifyClientSync, syncStatutLivreurOnCourse, verifierEncoursLivreur, syncCommandeFromCourse, validerPrimePromo. Anti-boucle: compare old_data vs data, sort si pas de changement pertinent.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "CourseExterne"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "silgapp_course_orchestrator",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "courseEventOrchestrator",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "courseEventOrchestrator"
  }
}