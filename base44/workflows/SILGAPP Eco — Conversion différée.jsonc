{
  "description": "Toutes les 10 minutes, convertit les courses Eco isol\u00e9es arriv\u00e9es \u00e0 leur seuil configurable vers Standard. Le seuil par d\u00e9faut reste 45 minutes; ce workflow est seulement un d\u00e9clencheur sobre, pas un polling minute par minute.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": "2026-10-09T00:00:00",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "SILGAPP Eco \u2014 Conversion diff\u00e9r\u00e9e",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "silgapp_eco_conversion_differee",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "convert_due": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ecoOptimizationOrchestrator",
            "args": {
              "action": "convert_due"
            }
          },
          "then": "expire_proposals"
        }
      },
      {
        "expire_proposals": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ecoOptimizationOrchestrator",
            "args": {
              "action": "expire_proposals"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}