  "name": "Rappels P\u00e9riodiques (5 min)",
  "description": "Envoie un rappel sonore FCM toutes les 5 minutes aux livreurs \u00e9ligibles tant que des courses restent disponibles. Ind\u00e9pendant du watchdog \u2014 garanti m\u00eame si le watchdog est lent ou en timeout. Anti-doublon par verrou atomique par pays.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Africa/Ouagadougou",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
