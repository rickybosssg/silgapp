{
  "name": "Lib\u00e9ration r\u00e9servations sur trajet expir\u00e9es",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Africa/Ouagadougou",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Filet de s\u00e9curit\u00e9 (5 min, minimum plateforme) : lib\u00e8re les r\u00e9servations exclusives sur trajet expir\u00e9es (15s). La lib\u00e9ration PRINCIPALE se fait en temps r\u00e9el via le lazy cleanup d\u00e9clench\u00e9 par les \u00e9v\u00e9nements syst\u00e8me (cr\u00e9ation de course, mise \u00e0 jour de course, polling livreur via getOnRouteProposalsForLivreur). Ce workflow ne sert qu'en cas de p\u00e9riode calme prolong\u00e9e o\u00f9 aucun \u00e9v\u00e9nement ne d\u00e9clencherait le lazy cleanup.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "release_expired_on_route_reservations",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "release_reservations": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ecoOptimizationOrchestrator",
            "args": {
              "action": "release_expired_reservations",
              "limit": 50
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Lib\u00e9rer r\u00e9servations expir\u00e9es",
            "description": "Lib\u00e8re les r\u00e9servations sur trajet expir\u00e9es et reprend le dispatch"
          }
        }
      }
    ]
  }
}