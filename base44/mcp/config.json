      {
        "name": "get_silgapp_overview",
        "title": "Get SILGAPP Overview",
        "description": "Vue d'ensemble globale de SILGAPP : total clients, livreurs, courses, chiffre d'affaires sur une période. Paramètres optionnels : date_debut (YYYY-MM-DD), date_fin (YYYY-MM-DD), country_code (ex: BF, CI).",
        "input_schema": {
          "type": "object",
          "properties": {
            "tool": { "type": "string", "enum": ["get_silgapp_overview"], "description": "Nom de l'outil" },
            "date_debut": { "type": "string", "description": "Date de début au format YYYY-MM-DD" },
            "date_fin": { "type": "string", "description": "Date de fin au format YYYY-MM-DD" },
            "country_code": { "type": "string", "description": "Code pays ISO 2 lettres (ex: BF, CI, TG) ou ALL" }
          },
          "required": ["tool"]
        },
        "handler": "silgappCopilotQuery",
        "annotations": { "read_only_hint": true, "destructive_hint": false, "idempotent_hint": true }
      },
      {
        "name": "get_courses_today",
        "title": "Get Courses Today",
        "description": "Courses créées aujourd'hui avec répartition par statut. Paramètres optionnels : country_code, limit (max 200).",
        "input_schema": {
          "type": "object",
          "properties": {
            "tool": { "type": "string", "enum": ["get_courses_today"], "description": "Nom de l'outil" },
            "country_code": { "type": "string", "description": "Code pays ISO 2 lettres" },
            "limit": { "type": "number", "description": "Nombre max de résultats (1-200, défaut 50)" }
          },
          "required": ["tool"]
        },
        "handler": "silgappCopilotQuery",
        "annotations": { "read_only_hint": true, "destructive_hint": false, "idempotent_hint": true }
      },
